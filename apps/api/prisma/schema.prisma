// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "sqlite"
}


model Category {
  id                String              @id @default(uuid())
  name              String
  color             String?
  icon              String
  budget            Decimal? // Optional monthly soft budget
  type              CategoryType        @default(EXPENSE)
  parentId          String?
  parent            Category?           @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children          Category[]          @relation("CategoryToCategory")
  profileId         String
  profile           Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  transactionSplits TransactionSplit[]
  savingsGoals      SavingsGoal[]
  categorizationRules CategorizationRule[]
  ruleSuggestions     RuleSuggestion[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  @@index([profileId])
}

model Account {
  id              String           @id @default(uuid())
  name            String
  initialBalance  Decimal          @default(0)
  type            AccountType      @default(DEBIT)
  profileId       String
  profile         Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  monthlyBalances MonthlyBalance[]
  accountBalances AccountBalance[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  @@index([profileId])
}

enum AccountType {
  DEBIT
  CREDIT
}

model CostObject {
  id                String              @id @default(uuid())
  name              String
  color             String?
  icon              String
  profileId         String
  profile           Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  transactionSplits TransactionSplit[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  @@index([profileId])
}

model Transaction {
  id           String             @id @default(uuid())
  date         DateTime
  amount       Decimal
  description  String
  categoryId   String?
  category     Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  accountId    String?
  account      Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  costObjectId String?
  costObject   CostObject?        @relation(fields: [costObjectId], references: [id], onDelete: SetNull)
  profileId    String
  profile      Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  notes        String?
  suggestedCategoryId String?     // ML suggestions - TO BE DEPRECATED
  merchant     String?            // Normalized merchant name for matching
  
  // Rule-based suggestion tracking
  suggestedByRuleId String?
  suggestedRule     CategorizationRule? @relation(fields: [suggestedByRuleId], references: [id], onDelete: SetNull)

  externalId   String?            @unique
  splits       TransactionSplit[] @relation("TransactionSplits")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([profileId])
  @@index([merchant])
  @@index([categoryId, date]) // For pattern detection
}

model CategorizationRule {
  id          String             @id @default(uuid())
  name        String             // User-friendly name
  description String?            // Optional notes
  enabled     Boolean            @default(true)
  priority    Int                @default(0) // Higher = evaluated first
  
  // Action configuration
  categoryId  String?
  category    Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  mode        RuleMode           @default(SUGGEST)
  
  profileId   String
  profile     Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  // Conditions (JSON string for flexibility)
  conditionsJson String
  
  // Statistics
  matchCount  Int                @default(0)
  lastMatched DateTime?
  
  // Relations
  suggestedTransactions Transaction[]
  
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  
  @@index([profileId])
  @@index([enabled, priority])
}

enum RuleMode {
  AUTO_APPLY
  SUGGEST
}

model RuleSuggestion {
  id             String    @id @default(uuid())
  
  // Suggested rule definition
  name           String
  description    String?
  conditionsJson String
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  profileId      String
  profile        Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  // Confidence metrics
  confidence     Decimal   // 0-100 score
  matchCount     Int       // Number of matching transactions
  similarityType String    // 'merchant', 'description', 'amount', 'notes', 'combined'
  
  // Sample transactions that match (JSON array of IDs)
  sampleTxIds    String
  
  // User action
  status         SuggestionStatus @default(PENDING)
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  @@index([profileId])
  @@index([status, confidence])
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model TransactionSplit {
  id           String       @id @default(uuid())
  parentId     String
  parent       Transaction  @relation("TransactionSplits", fields: [parentId], references: [id], onDelete: Cascade)
  amount       Decimal
  categoryId   String?
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  costObjectId String?
  costObject   CostObject?  @relation(fields: [costObjectId], references: [id], onDelete: SetNull)
  description  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model SavingsGoal {
  id           String    @id @default(uuid())
  name         String
  targetAmount Decimal
  startDate    DateTime  @default(now())
  targetDate   DateTime?
  savedAmount  Decimal   @default(0)
  isEvergreen  Boolean   @default(false)
  targetMonths Int?      // For evergreen goals: target months to fully fund
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  profileId    String
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  @@index([profileId])
}

model Setting {
  key   String @id
  value String
}

model Profile {
  id                   String                @id @default(uuid())
  name                 String                @unique
  pinHash              String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  sessions             Session[]
  categories           Category[]
  accounts             Account[]
  costObjects          CostObject[]
  transactions         Transaction[]
  categorizationRules  CategorizationRule[]
  ruleSuggestions      RuleSuggestion[]
  savingsGoals         SavingsGoal[]
  
  @@index([name])
}

model Session {
  id         String   @id @default(uuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  token      String   @unique
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  
  @@index([token])
  @@index([expiresAt])
  @@index([profileId])
}

enum CategoryType {
  INCOME
  EXPENSE
  GOAL
}

model MonthlyBalance {
  id        String   @id @default(uuid())
  month     String
  balance   Decimal  @default(0)
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, accountId])
}

model AccountBalance {
  id        String   @id @default(uuid())
  asOfDate  DateTime
  balance   Decimal  @default(0)
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([asOfDate, accountId])
}

